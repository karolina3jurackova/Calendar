@model Calendar.Application.ViewModels.EventCreateVM
@{
    ViewData["Title"] = "Create event";
}

<h2>Create event</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- Date (required) -->
    <div class="mb-3">
        <label class="form-label">Date</label>
        <input id="date" type="date" class="form-control" required />
        <div class="form-text">Stačí vybrať deň. Čas je voliteľný.</div>
    </div>

    <!-- Time (optional) -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Start time (optional)</label>
            <input id="startTime" type="time" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">End time (optional)</label>
            <input id="endTime" type="time" class="form-control" />
        </div>
    </div>

    <!-- Hidden fields bound to VM (datetime-local) -->
    <input asp-for="Start" id="Start" type="hidden" />
    <input asp-for="End" id="End" type="hidden" />

    <button class="btn btn-primary" type="submit">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Default times when user doesn't fill time
        const DEFAULT_START = "09:00";
        const DEFAULT_END = "10:00";

        function pad2(n) { return n.toString().padStart(2, "0"); }

        function todayIsoDate() {
            const d = new Date();
            return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
        }

        function toDateTimeLocal(dateStr, timeStr) {
            // returns "yyyy-MM-ddTHH:mm" (format for datetime-local)
            return `${dateStr}T${timeStr}`;
        }

        function syncHiddenFields() {
            const date = document.getElementById("date").value;
            if (!date) return;

            const sTime = document.getElementById("startTime").value || DEFAULT_START;
            const eTime = document.getElementById("endTime").value || DEFAULT_END;

            document.getElementById("Start").value = toDateTimeLocal(date, sTime);
            document.getElementById("End").value = toDateTimeLocal(date, eTime);
        }

        // init defaults
        document.getElementById("date").value = todayIsoDate();
        syncHiddenFields();

        document.getElementById("date").addEventListener("change", syncHiddenFields);
        document.getElementById("startTime").addEventListener("change", syncHiddenFields);
        document.getElementById("endTime").addEventListener("change", syncHiddenFields);

        // before submit ensure hidden fields are filled
        document.querySelector("form").addEventListener("submit", function () {
            syncHiddenFields();
        });
    </script>
}