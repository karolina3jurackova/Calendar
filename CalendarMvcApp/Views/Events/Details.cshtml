@model Calendar.Application.ViewModels.EventDetailVM

<h2>@Model.Title</h2>

<div class="card mb-3">
    <div class="card-body">
        <div><strong>Start:</strong> @Model.Start</div>
        <div><strong>End:</strong> @Model.End</div>
        <div><strong>Description:</strong> @Model.Description</div>
    </div>
</div>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>