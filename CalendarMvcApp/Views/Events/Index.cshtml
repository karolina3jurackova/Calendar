@model IList<Calendar.Application.ViewModels.EventListItemVM>

<h2>My events</h2>

<a class="btn btn-success mb-3" asp-action="Create">Create</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Start</th>
            <th>End</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Start</td>
                <td>@e.End</td>
                <td class="text-end">
                    <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@e.Id">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@e.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>