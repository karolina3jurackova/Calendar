<!DOCTYPE html>
<html lang="sk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalendarMvcApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CalendarMvcApp.styles.css" asp-append-version="true" />
</head>

<body>
    @{
        var currentArea = (string?)ViewContext.RouteData.Values["area"];
        var currentController = (string?)ViewContext.RouteData.Values["controller"];
        var currentAction = (string?)ViewContext.RouteData.Values["action"];

        string IsActive(string? area, string controller, string? action = null)
        {
            var areaMatch =
            string.IsNullOrWhiteSpace(area)
            ? string.IsNullOrWhiteSpace(currentArea)
            : string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase);

            if (!areaMatch) return "";

            if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
                return "";

            if (action != null && !string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
                return "";

            return "active fw-semibold";
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CalendarMvcApp</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @IsActive(null, "Home", "Index")" asp-area=""
                                asp-controller="Home" asp-action="Index">Home</a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link text-dark @IsActive(null, "Events")" asp-area="" asp-controller="Events"
                                asp-action="Index">Events</a>
                        </li>

                        @* Admin Area link (len pre Admin) *@
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger @IsActive("Admin", "Home", "Index")" asp-area="Admin"
                                        asp-controller="Home" asp-action="Index">Admin</a>
                                </li>
                            }
                        }
                    </ul>

                    @* ✅ IBA 1 SEARCH BAR + musí posielať Q *@
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <form class="d-flex me-3" asp-area="" asp-controller="Events" asp-action="Search" method="get"
                            role="search">
                            <input class="form-control form-control-sm me-2" type="search" name="Q"
                                value="@Context.Request.Query["Q"]" placeholder="Hľadať udalosti..." aria-label="Search" />
                            <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
                        </form>
                    }

                    <ul class="navbar-nav">
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-2">@User.Identity!.Name</span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @IsActive(null, "Account", "Login")" asp-controller="Account"
                                    asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @IsActive(null, "Account", "Register")"
                                    asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CalendarMvcApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div class="modal fade" id="reminderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reminderModalTitle">Pripomienka</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reminderModalBody">Máte udalosť.</div>
                    <div class="text-muted mt-2" id="reminderModalTime"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    @* Scripts *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* ✅ klientská validácia *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* ✅ site.js až po DOM *@
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>